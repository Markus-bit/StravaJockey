# Backend settings. Copy to .env and fill in. Never commit .env.

# Mapbox token used by the server for routing (keep it secret, separate from the public
# token in frontend/.env). Create it at https://account.mapbox.com/access-tokens/
MAPBOX_TOKEN=

PORT=4000
# LOG_LEVEL=info

# Behind a hosting proxy / load balancer, set the number of proxies in front of the app
# (usually 1) so rate limits apply per visitor.
# TRUST_PROXY=1

# Limits (defaults shown)
# MAX_WAYPOINTS=200
# MAX_ROUTE_KM=300
# RATE_LIMIT_WINDOW_MIN=10
# RATE_LIMIT_ROUTE=60
# RATE_LIMIT_GPX=20
# RATE_LIMIT_PREVIEW=120
# RATE_LIMIT_API=600
