# Backend settings (copy to .env)
MAPBOX_TOKEN=pk.your-mapbox-token
PORT=4000
# LOG_LEVEL=info

# Strava API app: https://www.strava.com/settings/api
# Set "Authorization Callback Domain" there to: localhost
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Defaults shown; change if you don't run the Vite dev server on :5173
# STRAVA_REDIRECT_URI=http://localhost:5173/api/strava/callback
# FRONTEND_URL=http://localhost:5173
