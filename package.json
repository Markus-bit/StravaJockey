{
  "name": "stravajockey",
  "version": "1.0.0",
  "description": "Draw a route on a map, set pace and heart rate, and download it as a GPX file. Express API + React/Vite frontend, deployed on Vercel.",
  "private": true,
  "license": "MIT",
  "author": "Markus-bit (https://github.com/Markus-bit)",
  "homepage": "https://www.stravajockey.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Markus-bit/StravaJockey.git"
  },
  "bugs": {
    "url": "https://github.com/Markus-bit/StravaJockey/issues"
  },
  "keywords": [
    "gpx",
    "route",
    "mapbox",
    "express",
    "react",
    "vite",
    "typescript",
    "vercel"
  ],
  "scripts": {
    "dev:server": "ts-node-dev --respawn --transpile-only src/server.ts",
    "dev:client": "npm --prefix frontend run dev",
    "dev": "concurrently -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "build": "tsc && npm --prefix frontend run build",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "lint": "npm --prefix frontend run lint",
    "check": "npm run typecheck && npm test && npm run lint && npm --prefix frontend run build"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.1.0",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.2",
    "pngjs": "^7.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.0",
    "@types/pngjs": "^6.0.5",
    "concurrently": "^9.2.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
